{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "default_agent": "build",
  "snapshots": true,
  "worktree": {
    "directory": "../hx-worktrees"
  },
  "permissions": [
    {
      "action": "hx_approve",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "hx_checks",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "hx_land",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "hx_land_legacy",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
