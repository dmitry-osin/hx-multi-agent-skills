{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HX Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "coverage",
    "scope",
    "limitations",
    "findings"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "APPROVED",
        "CHANGES_REQUESTED",
        "UNVERIFIED"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 3
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "file",
          "anchor",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 8
          },
          "recommendation": {
            "type": "string",
            "minLength": 4
          },
          "anchor": {
            "type": "string",
            "minLength": 3,
            "maxLength": 600,
            "description": "An exact substring of one source line at this revision; never guess the text or line."
          },
          "symbol": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160,
            "description": "Optional human-readable method/field name when line is not supplied; anchor must still uniquely locate source line."
          }
        }
      }
    },
    "coverage": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ]
    }
  }
}
